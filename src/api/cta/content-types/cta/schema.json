{
  "kind": "collectionType",
  "collectionName": "ctas",
  "info": {
    "singularName": "cta",
    "pluralName": "ctas",
    "displayName": "CTA"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "entryTitle": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "text": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "variant": {
      "type": "enumeration",
      "default": "primary",
      "enum": [
        "primary",
        "secondary",
        "outline"
      ]
    },
    "target": {
      "type": "enumeration",
      "default": "_self",
      "enum": [
        "_self",
        "_blank"
      ]
    }
  }
}
