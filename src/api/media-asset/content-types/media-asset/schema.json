{
  "kind": "collectionType",
  "collectionName": "media_assets",
  "info": {
    "singularName": "media-asset",
    "pluralName": "media-assets",
    "displayName": "Media"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "entryTitle": {
      "type": "text",
      "required": true,
      "unique": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "image",
      "enum": [
        "image",
        "video"
      ]
    },
    "alt": {
      "type": "string",
      "required": false
    },
    "desktopImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "desktopVideo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "videos"
      ]
    },
    "mobileVideo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "videos"
      ]
    }
  }
}
