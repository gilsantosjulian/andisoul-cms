{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "entryTitle": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^/?[a-z0-9-]+(/[a-z0-9-]+)*/?$"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.hero-section",
        "sections.featured-products",
        "sections.promo",
        "sections.content-creative-panel",
        "sections.categories"
      ]
    },
    "seo": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::seo.seo"
    }
  }
}
